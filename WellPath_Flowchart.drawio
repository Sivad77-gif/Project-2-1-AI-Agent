<mxfile host="app.diagrams.net">
  <diagram name="WellPath Personal Wellness AI" id="wellpath">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" value="Start: User opens WellPath" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="340" y="20" width="160" height="60" as="geometry" /></mxCell>
        <mxCell id="p1" value="User completes daily check-in (mood, sleep, activity)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="320" y="110" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="d1" value="Has user consented to data collection?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="320" y="200" width="200" height="110" as="geometry" /></mxCell>
        <mxCell id="aConsent" value="Action: Show plain-language privacy notice; offer guest mode (nothing saved)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="600" y="225" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="p2" value="AI analyzes check-in against user's goals and history" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="320" y="340" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="d2" value="Signs of crisis or self-harm?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="320" y="430" width="200" height="110" as="geometry" /></mxCell>
        <mxCell id="aCrisis" value="Action: Display 988 crisis line; offer to connect to a human counselor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="600" y="455" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="d3" value="Does user have an active wellness goal?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="320" y="570" width="200" height="110" as="geometry" /></mxCell>
        <mxCell id="aGoal" value="Action: Guide user to set a realistic goal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="595" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="p3" value="AI generates a personalized wellness recommendation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="320" y="710" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="aShow" value="Action: Display suggestion with &quot;Why am I seeing this?&quot; explanation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="320" y="800" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="d4" value="Did the user find the suggestion helpful?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="320" y="890" width="200" height="110" as="geometry" /></mxCell>
        <mxCell id="aYes" value="Action: Log progress and celebrate the streak" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="600" y="915" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="aNo" value="Action: Collect feedback and adjust future suggestions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1"><mxGeometry x="40" y="915" width="200" height="60" as="geometry" /></mxCell>
        <mxCell id="end" value="End of interaction" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="340" y="1060" width="160" height="60" as="geometry" /></mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="start" target="p1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="p1" target="d1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="d1" target="aConsent"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="d1" target="p2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="aConsent" target="end"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="860" y="255" /><mxPoint x="860" y="1090" /></Array></mxGeometry></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="p2" target="d2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="d2" target="aCrisis"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="aCrisis" target="end"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="860" y="485" /><mxPoint x="860" y="1090" /></Array></mxGeometry></mxCell>
        <mxCell id="e9" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="d2" target="d3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="d3" target="aGoal"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="aGoal" target="p3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="d3" target="p3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="p3" target="aShow"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="aShow" target="d4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="d4" target="aYes"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e16" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;" edge="1" parent="1" source="d4" target="aNo"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e17" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=1;entryY=0.5;" edge="1" parent="1" source="aYes" target="end"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e18" style="edgeStyle=orthogonalEdgeStyle;html=1;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="aNo" target="end"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
